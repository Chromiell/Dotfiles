# Absolute path to the host directory where Gitea and its runner store data.
# The stacks mount "${GITEA_DATA_ROOT}/gitea" and "${GITEA_DATA_ROOT}/gitea-runner".
# Use an absolute path; "~" expansion is not supported here.
GITEA_DATA_ROOT=/home/admin

GITEA_RUNNER_REGISTRATION_TOKEN=replace-with-token-from-gitea
GITEA_RUNNER_NAME=my-docker-runner
