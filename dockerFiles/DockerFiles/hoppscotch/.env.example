# Copy to .env and replace every placeholder. Do not wrap values in quotes.
#
# Hoppscotch Community Edition 2026.11.0 (MIT). No licence key is required,
# but pin the image tag: the vendor announced paid-tier gating of team
# workspaces on 2026-11-23, so treat any upgrade as a deliberate decision.

# --- Database ---------------------------------------------------------------
# Also embedded into DATABASE_URL by docker-compose.yml, so keep it URL-safe
# (letters and digits only). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Instance URLs (browser-facing) ----------------------------------------
# Replace 192.168.1.50 with the LAN address or hostname your team will use.
# These must be the addresses the browser sees, not the container's.
VITE_BASE_URL=http://192.168.1.50:50020
VITE_SHORTCODE_BASE_URL=http://192.168.1.50:50020
VITE_ADMIN_URL=http://192.168.1.50:50021
VITE_BACKEND_GQL_URL=http://192.168.1.50:50022/graphql
VITE_BACKEND_WS_URL=ws://192.168.1.50:50022/graphql
VITE_BACKEND_API_URL=http://192.168.1.50:50022/v1

# --- Security ---------------------------------------------------------------
# Comma-separated, no spaces. Must list the origins the browser loads from.
# The last two entries are the Hoppscotch desktop app: it builds its webview
# origin from the host by replacing '.', ':' and '-' with '_', e.g. host
# hopp.example.com:50020 -> app://hopp_example_com_50020 (Linux/macOS) and
# http://app.hopp_example_com_50020 (Windows).
WHITELISTED_ORIGINS=http://192.168.1.50:50020,http://192.168.1.50:50021,http://192.168.1.50:50022,app://192_168_1_50_50020,http://app.192_168_1_50_50020

# Exactly 32 characters; encrypts sensitive values in the database.
# Generate once and back it up — losing it makes stored secrets unrecoverable.
DATA_ENCRYPTION_KEY=replace-with-32-character-key

# Keep false for direct port access over LAN/VPN. Set true only when a reverse
# proxy serves the app at /, admin at /admin and backend at /backend.
ENABLE_SUBPATH_BASED_ACCESS=false

# --- Optional ---------------------------------------------------------------
# Internal Caddy port when port 80 inside the container is unavailable
# (rootless Docker, Podman). Also update the port mapping if you set it.
# HOPP_ALTERNATE_PORT=8000
