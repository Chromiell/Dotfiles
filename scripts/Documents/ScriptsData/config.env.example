# ==============================================================================
# Environment Configuration & Sensitive Data (Template)
# ==============================================================================
# Copy this file to config.env in Documents/ScriptsData/ and fill in the values:
#   cp config.env.example config.env
# ==============================================================================

# --- Nightly Production Database Dump (nightlyProdDump.sh) ---
PROD_DUMP_DIR="/path/to/ProdDump"
PROD_DUMP_POST_SCRIPT="/path/to/Documents/Scripts/postImportDBAlter.sh"
PROD_DUMP_REMOTE_SSH_USER="remote_ssh_user"
PROD_DUMP_REMOTE_SSH_HOST="remote.server.ip.or.host"
PROD_DUMP_REMOTE_DB_USER="remote_db_user"
PROD_DUMP_REMOTE_DB_PASSWORD="remote_db_password"
PROD_DUMP_REMOTE_DB_NAME="remote_database_name"
PROD_DUMP_LOCAL_DB_USER="root"
PROD_DUMP_LOCAL_DB_PASSWORD="local_db_password"
PROD_DUMP_LOCAL_DB_NAME="local_database_name"
PROD_DUMP_TABLES="table1 table2 table3"

# --- HAProxy & SSL Management (certbotAddDomain.sh, certbotDeleteDomain.sh) ---
REMOTE_HAPROXY_HOST="192.168.x.x"
HAPROXY_SSL_DIR="/etc/haproxy/ssl"
CERTBOT_PORT=8888

# --- Mantis DB Backup (dumpMantisDB.sh) ---
MANTIS_TARGET_DIR="/mnt/bckmantis"
MANTIS_CIFS_SHARE="//server/share/bckmantis"
MANTIS_CIFS_CREDENTIALS="/etc/samba/.smbcredentials"
MANTIS_DB_USER="root"
MANTIS_LOCAL_DB_PASSWORD="local_db_password"
MANTIS_DB_NAME="mantis"

# Common / Global local DB password fallback
LOCAL_DB_PASSWORD="local_db_password"

# --- Sync Production DB Dump Share (moveDBDump.sh) ---
MOVE_DUMP_TARGET_DIR="/mnt/bckshare"
MOVE_DUMP_SOURCE_DIR="/path/to/ProdDump"
MOVE_DUMP_CIFS_SHARE="//server/share/bckdump"
MOVE_DUMP_CIFS_CREDENTIALS="/etc/samba/.smbcredentials"

# --- Post Import Database Alterations (postImportDBAlter.sh) ---
POST_IMPORT_BASE_DIR="/path/to/public_html/database"
POST_IMPORT_URL_BASE="http://dev.example.com/database"

# --- SFTP Dump Grabber (sftpGrab.sh) ---
SFTP_HOST="example.com"
SFTP_USER="username"
SFTP_PASSWORD="password"
SFTP_REMOTE_FILE="/path/to/remote/dump.sql"
SFTP_LOCAL_DIR="/path/to/local/dir"

# --- Deployment (gitpull.sh, gitpullPostScript.sh) ---
DEPLOY_ROOT="/var/www/html"
DEPLOY_TARGET_1="application_1"
DEPLOY_TARGET_2="application_2"
DEPLOY_TARGET_3="application_3"
DEPLOY_TARGET_4="application_4"
DEPLOY_TARGET_5="application_5"
DEPLOY_STORAGE_DIR="/var/www/html/application_5/storage"

# --- Update Notifications & Email (checkUpdates.sh) ---
GMAIL_ACCOUNT="gmail"
GMAIL_HOST="smtp.gmail.com"
GMAIL_PORT=587
GMAIL_USER="smtp_user"
GMAIL_APP_PASSWORD="smtp_password"
EMAIL_FROM="notifications@example.com"
EMAIL_TO="admin@example.com"
EMAIL_SUBJECT="System Updates Available"
EMAIL_BODY="New system updates are available."
